# --- Modèle (OpenRouter) — sans clé, ATLAS démarre en mode démo
OPENROUTER_API_KEY=
# Vérifie les identifiants exacts sur openrouter.ai/models ; le modèle doit supporter le tool calling
MODEL_FAST=deepseek/deepseek-chat
MODEL_MAIN=deepseek/deepseek-chat
MODEL_DEEP=deepseek/deepseek-chat

# --- Stockage : vide = SQLite local (data/atlas.db)
# Supabase : Project Settings > Database > Connection string (URI)
DATABASE_URL=

# --- Embeddings (optionnel) : endpoint compatible OpenAI /v1/embeddings
EMBEDDINGS_URL=
EMBEDDINGS_KEY=
EMBEDDINGS_MODEL=

ATLAS_TZ=Europe/Paris

# Copier ce fichier vers .env, qui n'est jamais versionné.

# Niveau de journalisation : DEBUG, INFO, WARNING, ERROR
ATLAS_LOG_LEVEL=INFO
# Fichier de journal (rotation simple, 1 Mo x 4) ; défaut : le dossier « logs » à côté de la base
# ATLAS_LOG_DIR=data/logs

# Base SQLite locale (reçus, consommation, tâches) ; le dossier est créé si besoin
ATLAS_DATABASE_PATH=data/atlas.db

# Modèle de langage : openrouter (défaut, cloud) ou ollama (local)
ATLAS_PROVIDER=openrouter
# Obligatoire si ATLAS_PROVIDER=openrouter. Ne jamais commiter la vraie clé.
ATLAS_OPENROUTER_API_KEY=
# Défaut OpenRouter : deepseek/deepseek-v4.1-flash-1017. Obligatoire pour ollama (voir `ollama list`).
# Attention : ce modèle n'est pas disponible en routage UE ; pas de données sensibles via OpenRouter.
ATLAS_MODEL=
# Endpoint Ollama compatible OpenAI
ATLAS_OLLAMA_BASE_URL=http://localhost:11434/v1
# Délai maximal d'un appel au modèle, en secondes
ATLAS_TIMEOUT=60

# Boucle agent
ATLAS_MAX_TOOL_ROUNDS=6
ATLAS_HISTORY_MESSAGES=16
# Forme d'adresse de l'agent : tu ou vous
ATLAS_ADDRESS_FORM=tu

# Détecteur d'affirmations d'action du vérificateur ; aujourd'hui : rules
# Un autre détecteur en panne laisse les règles prendre le relais (avertissement journalisé).
ATLAS_CLAIM_DETECTOR=rules
# Délai maximal d'un appel au détecteur, en secondes (défaut 1) ; au-delà, repli sur les règles
ATLAS_CLAIM_DETECTOR_TIMEOUT=1.0
# Dépassements de délai tolérés avant de désactiver le détecteur pour la session (défaut 3)
ATLAS_CLAIM_DETECTOR_MAX_TIMEOUTS=3

# Budgets quotidiens (un tour est refusé dès que l'un est atteint)
ATLAS_DAILY_TOKEN_BUDGET=200000
ATLAS_DAILY_COST_BUDGET=1.0

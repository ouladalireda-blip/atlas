# Fins de ligne et indentation communes à tous les éditeurs (voir aussi .gitattributes).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space

[*.py]
indent_size = 4

[*.{yaml,yml,md}]
indent_size = 2

# Scripts Windows : CRLF, comme dans .gitattributes.
[*.{bat,cmd,ps1}]
end_of_line = crlf
